<mxfile host="app.diagrams.net">
  <diagram name="GreenChit Container Diagram" id="gc-c4l2">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1860" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="GreenChit - Container Diagram (C4 Level 2)" style="text;html=1;fontStyle=1;fontSize=24;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="1000" height="36" as="geometry" /></mxCell>
        <mxCell id="subtitle" value="Staff expense claims: submit, approve, export to payroll. Everything inside the dashed box is built and run by us." style="text;html=1;fontSize=14;fontColor=#555555;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="52" width="1200" height="24" as="geometry" /></mxCell>
        <mxCell id="boundary" value="GreenChit [System boundary]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#555555;strokeWidth=2;dashed=1;dashPattern=8 8;verticalAlign=bottom;align=left;spacingLeft=14;spacingBottom=6;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="330" y="150" width="1150" height="700" as="geometry" /></mxCell>
        <mxCell id="staff" value="&lt;b&gt;Staff (claimant)&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;Submits claims and tracks their status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="20" y="170" width="200" height="100" as="geometry" /></mxCell>
        <mxCell id="mgr" value="&lt;b&gt;Line manager&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;Approves, rejects or asks for more information" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="20" y="310" width="200" height="100" as="geometry" /></mxCell>
        <mxCell id="fin" value="&lt;b&gt;Finance&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;Reviews approved claims for payroll" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="20" y="450" width="200" height="100" as="geometry" /></mxCell>
        <mxCell id="audit" value="&lt;b&gt;Audit role&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;Views claims and the audit log" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="20" y="590" width="200" height="100" as="geometry" /></mxCell>
        <mxCell id="web" value="&lt;b&gt;Web app&lt;/b&gt;&lt;br&gt;[React single-page app, TypeScript]&lt;br&gt;Lets staff and managers submit, track and approve claims" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="370" y="190" width="240" height="120" as="geometry" /></mxCell>
        <mxCell id="api" value="&lt;b&gt;Claims API&lt;/b&gt;&lt;br&gt;[.NET 8 on Azure App Service]&lt;br&gt;Checks login and runs the claim rules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="760" y="190" width="240" height="120" as="geometry" /></mxCell>
        <mxCell id="sql" value="&lt;b&gt;Claims database&lt;/b&gt;&lt;br&gt;[Azure SQL Database, ledger tables for audit]&lt;br&gt;Stores claims and the tamper-evident audit log" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1180" y="190" width="240" height="120" as="geometry" /></mxCell>
        <mxCell id="blob" value="&lt;b&gt;Receipt storage&lt;/b&gt;&lt;br&gt;[Azure Blob Storage, malware scanning]&lt;br&gt;Holds receipt images, scanned for malware" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="370" y="450" width="240" height="120" as="geometry" /></mxCell>
        <mxCell id="queue" value="&lt;b&gt;Message queue&lt;/b&gt;&lt;br&gt;[Azure Service Bus queue]&lt;br&gt;Holds claim events for the worker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="760" y="450" width="240" height="120" as="geometry" /></mxCell>
        <mxCell id="export" value="&lt;b&gt;Export job&lt;/b&gt;&lt;br&gt;[.NET WebJob on App Service, scheduled]&lt;br&gt;Writes the approved-claims CSV for payroll" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1180" y="450" width="240" height="120" as="geometry" /></mxCell>
        <mxCell id="worker" value="&lt;b&gt;Notification worker&lt;/b&gt;&lt;br&gt;[.NET WebJob on App Service]&lt;br&gt;Sends a Teams card, or an email if Teams fails" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="760" y="710" width="240" height="120" as="geometry" /></mxCell>
        <mxCell id="entra" value="&lt;b&gt;Microsoft Entra ID&lt;/b&gt;&lt;br&gt;[External system]&lt;br&gt;Single sign-on for BISTEC staff" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ededed;strokeColor=#888888;strokeWidth=2;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1580" y="190" width="250" height="110" as="geometry" /></mxCell>
        <mxCell id="sp" value="&lt;b&gt;SharePoint folder&lt;/b&gt;&lt;br&gt;[External system]&lt;br&gt;Folder watched by the payroll automation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ededed;strokeColor=#888888;strokeWidth=2;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1580" y="450" width="250" height="110" as="geometry" /></mxCell>
        <mxCell id="teams" value="&lt;b&gt;Microsoft Teams&lt;/b&gt;&lt;br&gt;[External system]&lt;br&gt;Shows Adaptive Cards to managers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ededed;strokeColor=#888888;strokeWidth=2;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1580" y="640" width="250" height="110" as="geometry" /></mxCell>
        <mxCell id="email" value="&lt;b&gt;Email service&lt;/b&gt;&lt;br&gt;[External system]&lt;br&gt;Used only when Teams fails" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ededed;strokeColor=#888888;strokeWidth=2;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1580" y="780" width="250" height="110" as="geometry" /></mxCell>
        <mxCell id="e1" value="Submits claims — browser UI" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.15;" edge="1" parent="1" source="staff" target="web"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e2" value="Approves claims — browser UI" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.4;" edge="1" parent="1" source="mgr" target="web"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e3" value="Reviews claims — browser UI" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.65;" edge="1" parent="1" source="fin" target="web"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e4" value="Views audit log — browser UI" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.9;" edge="1" parent="1" source="audit" target="web"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e5" value="Calls claims API — HTTPS/JSON" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="web" target="api"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e6" value="Reads and writes claims — SQL (TDS)" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="api" target="sql"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e7" value="Uploads receipts — HTTPS (signed URL)" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.25;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="web" target="blob"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e8" value="Issues signed URLs, checks uploads — HTTPS" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.2;exitY=1;entryX=1;entryY=0.3;" edge="1" parent="1" source="api" target="blob"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e9" value="Publishes claim events — AMQP" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.65;exitY=1;entryX=0.65;entryY=0;" edge="1" parent="1" source="api" target="queue"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e10" value="Receives claim events from — AMQP" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="worker" target="queue"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e11" value="Posts Adaptive Card first — HTTPS webhook" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="worker" target="teams"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e12" value="Sends email only if Teams fails — SMTP" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" edge="1" parent="1" source="worker" target="email"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e13" value="Reads approved claims — SQL (TDS)" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.3;exitY=0;entryX=0.3;entryY=1;" edge="1" parent="1" source="export" target="sql"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e14" value="Drops CSV file — HTTPS (Graph API)" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="export" target="sp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e15" value="Signs users in — OIDC" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.75;entryY=0;" edge="1" parent="1" source="web" target="entra"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="490" y="115" /><mxPoint x="1767" y="115" /></Array></mxGeometry></mxCell>
        <mxCell id="e16" value="Fetches token signing keys — HTTPS (OIDC)" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.35;entryY=0;" edge="1" parent="1" source="api" target="entra"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="880" y="140" /><mxPoint x="1667" y="140" /></Array></mxGeometry></mxCell>
      </root>
