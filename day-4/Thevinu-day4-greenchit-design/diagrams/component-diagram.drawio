<mxfile host="app.diagrams.net">
  <diagram name="GreenChit Component Diagram - Claims API" id="gc-c4l3">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="960" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="GreenChit - Component Diagram of the Claims API (C4 Level 3)" style="text;html=1;fontStyle=1;fontSize=24;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="1000" height="36" as="geometry" /></mxCell>
        <mxCell id="subtitle" value="A zoom into one container. Same shapes, colours and arrow labels as the container diagram." style="text;html=1;fontSize=14;fontColor=#555555;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="52" width="1200" height="24" as="geometry" /></mxCell>
        <mxCell id="boundary" value="Claims API [Container: .NET 8 on Azure App Service]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#555555;strokeWidth=2;dashed=1;dashPattern=8 8;verticalAlign=bottom;align=left;spacingLeft=14;spacingBottom=6;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="330" y="150" width="1000" height="640" as="geometry" /></mxCell>
        <mxCell id="web" value="&lt;b&gt;Web app&lt;/b&gt;&lt;br&gt;[React single-page app, TypeScript]&lt;br&gt;Lets staff and managers submit, track and approve claims" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="30" y="380" width="240" height="120" as="geometry" /></mxCell>
        <mxCell id="entra" value="&lt;b&gt;Microsoft Entra ID&lt;/b&gt;&lt;br&gt;[External system]&lt;br&gt;Single sign-on for BISTEC staff" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ededed;strokeColor=#888888;strokeWidth=2;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="30" y="640" width="200" height="110" as="geometry" /></mxCell>
        <mxCell id="auth" value="&lt;b&gt;Auth&lt;/b&gt;&lt;br&gt;[Component: .NET module]&lt;br&gt;Checks the login token and who may view or change a claim" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="370" y="380" width="240" height="110" as="geometry" /></mxCell>
        <mxCell id="approvals" value="&lt;b&gt;Approvals&lt;/b&gt;&lt;br&gt;[Component: .NET module]&lt;br&gt;Handles the manager&#x27;s approve, reject and request-more-info" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="740" y="190" width="240" height="110" as="geometry" /></mxCell>
        <mxCell id="claims" value="&lt;b&gt;Claims&lt;/b&gt;&lt;br&gt;[Component: .NET module]&lt;br&gt;Validates claims and owns every status change" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="740" y="380" width="240" height="110" as="geometry" /></mxCell>
        <mxCell id="receipts" value="&lt;b&gt;Receipts&lt;/b&gt;&lt;br&gt;[Component: .NET module]&lt;br&gt;Checks file limits and issues signed upload URLs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="740" y="570" width="240" height="110" as="geometry" /></mxCell>
        <mxCell id="notif" value="&lt;b&gt;Notifications&lt;/b&gt;&lt;br&gt;[Component: .NET module]&lt;br&gt;Publishes the events that trigger Teams and email messages" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1080" y="190" width="240" height="110" as="geometry" /></mxCell>
        <mxCell id="audit" value="&lt;b&gt;Audit&lt;/b&gt;&lt;br&gt;[Component: .NET module]&lt;br&gt;Writes a tamper-evident row for every status change" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1080" y="380" width="240" height="110" as="geometry" /></mxCell>
        <mxCell id="queue" value="&lt;b&gt;Message queue&lt;/b&gt;&lt;br&gt;[Azure Service Bus queue]&lt;br&gt;Holds claim events for the worker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1450" y="190" width="250" height="110" as="geometry" /></mxCell>
        <mxCell id="sql" value="&lt;b&gt;Claims database&lt;/b&gt;&lt;br&gt;[Azure SQL Database, ledger tables for audit]&lt;br&gt;Stores claims and the tamper-evident audit log" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1450" y="475" width="250" height="110" as="geometry" /></mxCell>
        <mxCell id="blob" value="&lt;b&gt;Receipt storage&lt;/b&gt;&lt;br&gt;[Azure Blob Storage, malware scanning]&lt;br&gt;Holds receipt images, scanned for malware" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1450" y="660" width="250" height="110" as="geometry" /></mxCell>
        <mxCell id="e1" value="Sends requests with token — HTTPS" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="web" target="auth"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e2" value="Uploads receipts — HTTPS (signed URL)" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.95;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="web" target="blob"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="258" y="830" /><mxPoint x="1575" y="830" /></Array></mxGeometry></mxCell>
        <mxCell id="e3" value="Signs users in — OIDC" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="web" target="entra"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e4" value="Fetches token signing keys — HTTPS (OIDC)" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.25;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="auth" target="entra"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="430" y="695" /></Array></mxGeometry></mxCell>
        <mxCell id="e5" value="Passes checked request — method call" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.15;entryX=0;entryY=0.5;" edge="1" parent="1" source="auth" target="approvals"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e6" value="Passes checked request — method call" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="auth" target="claims"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e7" value="Passes request to view a receipt — method call" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.85;entryX=0;entryY=0.5;" edge="1" parent="1" source="auth" target="receipts"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e8" value="Asks for upload URLs and file check — method call" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="claims" target="receipts"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e9" value="Changes status — method call" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="approvals" target="claims"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e10" value="Requests a notification — method call" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.15;entryX=0;entryY=0.8;" edge="1" parent="1" source="claims" target="notif"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e11" value="Records the change — method call" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="claims" target="audit"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e12" value="Publishes claim events — AMQP" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="notif" target="queue"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e13" value="Saves claims — SQL (TDS)" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.8;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="claims" target="sql"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="932" y="530" /></Array></mxGeometry></mxCell>
        <mxCell id="e14" value="Writes audit rows — SQL (TDS)" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.3;entryY=0;" edge="1" parent="1" source="audit" target="sql"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1525" y="435" /></Array></mxGeometry></mxCell>
        <mxCell id="e15" value="Issues signed URLs, checks uploads — HTTPS" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="receipts" target="blob"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
