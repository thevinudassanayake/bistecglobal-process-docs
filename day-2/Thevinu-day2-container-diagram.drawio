        <mxCell id="identity" value="&lt;b&gt;Microsoft Entra External ID&lt;/b&gt;&lt;br&gt;[External system]&lt;br&gt;Authn / JWT issue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ededed;strokeColor=#666666;strokeWidth=2;fontSize=13;arcSize=8;" vertex="1" parent="1"><mxGeometry x="860" y="90" width="250" height="110" as="geometry" /></mxCell>
        <mxCell id="blob" value="&lt;b&gt;Object store&lt;/b&gt;&lt;br&gt;[Azure Blob Storage]&lt;br&gt;Book photos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d3;strokeColor=#82b266;strokeWidth=2;fontSize=13;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="250" height="110" as="geometry" /></mxCell>
        <mxCell id="api" value="&lt;b&gt;API service&lt;/b&gt;&lt;br&gt;[Node.js Express, Azure App Service]&lt;br&gt;REST API; enqueues email jobs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=13;arcSize=8;" vertex="1" parent="1"><mxGeometry x="450" y="290" width="250" height="110" as="geometry" /></mxCell>
