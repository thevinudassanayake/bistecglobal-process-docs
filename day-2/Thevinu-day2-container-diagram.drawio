        <mxCell id="e7" value="&lt;b&gt;Reads, writes records&lt;/b&gt;&lt;br&gt;[SQL | sync]" style="endArrow=block;endFill=1;html=1;strokeWidth=2.4;strokeColor=#1f4c75;fontColor=#1f4c75;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="api" target="sql"><mxGeometry relative="1" as="geometry"><mxPoint as="sourcePoint" x="700" y="345" /><mxPoint as="targetPoint" x="860" y="345" /></mxGeometry></mxCell>
        <mxCell id="e8" value="&lt;b&gt;Enqueues email jobs&lt;/b&gt;&lt;br&gt;[AMQP | async]" style="endArrow=block;endFill=1;html=1;strokeWidth=2.4;strokeColor=#d97300;fontColor=#d97300;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="api" target="queue"><mxGeometry relative="1" as="geometry"><mxPoint as="sourcePoint" x="660" y="400" /><mxPoint as="targetPoint" x="900" y="490" /></mxGeometry></mxCell>
        <mxCell id="e9" value="&lt;b&gt;Caches hot books&lt;/b&gt;&lt;br&gt;[Redis/TLS | sync]" style="endArrow=block;endFill=1;html=1;strokeWidth=2.4;strokeColor=#1f4c75;fontColor=#1f4c75;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="api" target="redis"><mxGeometry relative="1" as="geometry"><mxPoint as="sourcePoint" x="575" y="400" /><mxPoint as="targetPoint" x="575" y="490" /></mxGeometry></mxCell>
        <mxCell id="e10" value="&lt;b&gt;Delivers email jobs&lt;/b&gt;&lt;br&gt;[AMQP | async]" style="endArrow=block;endFill=1;html=1;strokeWidth=2.4;strokeColor=#d97300;fontColor=#d97300;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="queue" target="worker"><mxGeometry relative="1" as="geometry"><mxPoint as="sourcePoint" x="985" y="600" /><mxPoint as="targetPoint" x="985" y="690" /></mxGeometry></mxCell>
        <mxCell id="e11" value="&lt;b&gt;Sends emails&lt;/b&gt;&lt;br&gt;[HTTPS | sync]" style="endArrow=block;endFill=1;html=1;strokeWidth=2.4;strokeColor=#1f4c75;fontColor=#1f4c75;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="worker" target="email"><mxGeometry relative="1" as="geometry"><mxPoint as="sourcePoint" x="860" y="745" /><mxPoint as="targetPoint" x="700" y="745" /></mxGeometry></mxCell>
        <mxCell id="legend" value="&lt;b&gt;How to read it&lt;/b&gt;&lt;br&gt;Solid blue arrow: synchronous call, caller waits&lt;br&gt;Dashed orange arrow: async message, caller moves on&lt;br&gt;Blue: our apps. Green: data stores, queue.&lt;br&gt;Grey: external services. Yellow: person." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#fafafa;strokeColor=#999999;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="370" height="150" as="geometry" /></mxCell>
