        <mxCell id="member" value="&lt;b&gt;Member&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;Neighbour who lists and borrows books" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="250" height="110" as="geometry" /></mxCell>
