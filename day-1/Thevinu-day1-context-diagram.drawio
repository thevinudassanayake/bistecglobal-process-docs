          <mxGeometry x="40" y="20" width="900" height="40" as="geometry" />
        </mxCell>
        <mxCell id="platform" value="&lt;b style=&quot;font-size:22px&quot;&gt;LearnLanka Platform&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;&lt;br&gt;Lets students find, book and pay&lt;br&gt;for 1-to-1 online tutoring, and&lt;br&gt;pays tutors weekly" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=3;fontSize=14;arcSize=4;" vertex="1" parent="1">
